# ─────────────────────────────────────────────────────────────
# Config para smoke.sh — copiar a smoke.env y llenar valores.
# smoke.env está en .gitignore, no se commitea.
# ─────────────────────────────────────────────────────────────

# URL base a testear
BASE_URL=https://psico.wailus.co

# Timeout de cada request individual, en segundos
TIMEOUT_SEC=15

# ─── Bot API ────────────────────────────────────────────────
# Key configurada en el .env del server como BOT_API_KEY.
# Empieza con psb_...
BOT_API_KEY=

# Teléfonos de referencia para bot/identify (E.164 con +).
# STAFF_PHONE: el número de UN profesional registrado en la plataforma.
# PATIENT_PHONE: el número de UN paciente cuya cuenta esté activada.
# Ambos son solo para lectura + opt-in idempotente.
STAFF_PHONE="+57 304 219 0650"
PATIENT_PHONE=""
UNKNOWN_PHONE="+57 111 111 1111"

# ─── Credenciales staff ─────────────────────────────────────
# Usuario "psicólogo de pruebas" — es el mismo que tiene
# whitelist para Liquid Glass. Password: pedile a Stiven o
# creá uno de test específicamente para smoke.
STAFF_EMAIL="psicologo.demo@psicomorfosis.co"
STAFF_PASSWORD=""

# ─── Credenciales paciente ──────────────────────────────────
# Paciente demo con cuenta activada. Ejemplo:
#   PATIENT_EMAIL=andres.galeano.demo@example.com
# Pedile a Stiven la password o creá una cuenta demo con
# password conocida solo para smoke.
PATIENT_EMAIL=""
PATIENT_PASSWORD=""
